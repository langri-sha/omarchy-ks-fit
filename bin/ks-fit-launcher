#!/usr/bin/env bash
# Starts the helper for the plugin's service. Quickshell kills a destroyed
# Process's direct child outright, so the helper runs as this script's child
# instead: it then reads EOF on stdin and shuts down cleanly, without touching
# the belt.
set -euo pipefail

if ((EUID == 0)); then
  echo 'ks-fit-launcher: refusing to run as root' >&2
  exit 1
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
version=$(jq -r .version "$root/manifest.json")
helpers=${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-ks-fit/helpers
helper=${KS_FIT_HELPER:-$helpers/$version/ks-fit}

if [[ ! -x $helper ]]; then
  code=helper-missing
  # A helper built for another version means the plugin was updated.
  if [[ -z ${KS_FIT_HELPER:-} ]] && compgen -G "$helpers/*/ks-fit" >/dev/null; then
    code=helper-outdated
  fi
  jq -cn --arg code "$code" --arg version "$version" --arg message "No KS Fit helper at $helper" \
    '{type: "fatal", code: $code, version: $version, message: $message}'
  exit 127
fi

"$helper" daemon "$@" <&0 &
pid=$!

# Once this version's helper has come up, builds for other versions are dead
# weight; until then they are what tells an update from a first run.
if [[ -z ${KS_FIT_HELPER:-} ]]; then
  (
    sleep 2
    kill -0 "$pid" 2>/dev/null || exit 0
    for old in "$helpers"/*/; do
      old=${old%/}
      if [[ $old != "$helpers/$version" ]]; then
        rm -f -- "$old/ks-fit"
        rmdir -- "$old" 2>/dev/null || true
      fi
    done
  ) </dev/null >/dev/null 2>&1 &
fi

# Quickshell's `running = false` sends TERM to this script only; pass it on so
# the helper shuts down on its own terms rather than being orphaned.
trap 'kill -TERM "$pid" 2>/dev/null' TERM
trap 'kill -INT "$pid" 2>/dev/null' INT

# A trapped signal interrupts `wait`; keep waiting until the helper is gone,
# then exit with its status.
set +e
while :; do
  wait "$pid"
  status=$?
  kill -0 "$pid" 2>/dev/null || break
done
exit "$status"
