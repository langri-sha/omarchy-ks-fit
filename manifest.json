{
  "schemaVersion": 1,
  "id": "io.github.langri-sha.ks-fit",
  "name": "KS Fit",
  "version": "0.1.0",
  "author": "Filip Dupanović",
  "license": "MIT",
  "description": "Control a KingSmith WalkingPad from the bar and chart your steps and calories.",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "shell/Service.qml",
    "barWidget": "shell/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "KS Fit",
    "description": "WalkingPad control, live workout and step and calorie history",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "weightKg": 70,
      "demo": false
    },
    "schema": [
      {
        "key": "weightKg",
        "type": "integer",
        "label": "Body weight (kg)",
        "min": 20,
        "max": 300,
        "step": 1,
        "defaultValue": 70
      },
      {
        "key": "demo",
        "type": "boolean",
        "label": "Demo mode (simulated pad)",
        "defaultValue": false
      }
    ]
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
